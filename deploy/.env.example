# deploy/.env on the production server (copy of this file; chmod 600; NEVER in git, no real values here).
# docker-compose.prod.yml reads it; promote.sh checks it and writes RADAR_TAG / RADAR_TAG_PREV.
# lib/__tests__/deploy-files.test.ts fails when the app reads an environment variable that is in neither
# this file nor the compose file.

# --- set by promote.sh (leave empty before the first promotion) ---
# The image tag that runs (the full commit sha of main), and the one before it (rollback).
RADAR_TAG=
RADAR_TAG_PREV=

# --- required ---
# Signs the session and proof cookies. At least 32 characters: openssl rand -hex 32
AUTH_SECRET=

# Mail for password-reset links. Without SMTP_HOST nothing is sent; promote.sh refuses
# to run without host, user and password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Powercoders Job Radar <noreply@radar.gnamak.ch>

# --- optional ---
# Public address (also baked into the image at build time). Empty = https://radar.gnamak.ch.
NEXT_PUBLIC_APP_URL=
# 1 = the second factor is mandatory for every admin (turn on once every board member has set it up).
ADMIN_TOTP_REQUIRED=
# Where the SQLite file lives on the host (owned by uid 1001). Empty = /home/ubuntu/radar-data.
RADAR_DATA_DIR=

# --- never set on this server (compose sets them, or they must stay unset) ---
# APP_ENV=production, TRUST_PROXY=true, DATABASE_URL, NODE_ENV, PORT, HOSTNAME: fixed in docker-compose.prod.yml.
# DEMO_INSTANCE: only on Pandora's CI test server; promote.sh refuses a .env that has it.
# EMAIL_STUB: the boot guard refuses production with it.
